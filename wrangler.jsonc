{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "compass",
  "main": "server/.generated/worker.mjs",
  "compatibility_date": "2026-11-10",
  "keep_vars": true,
  "build": { "command": "npm run worker:prepare" },
  "assets": { "directory": "server/public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "compass",
    // Replace with the ID returned by `wrangler d1 create compass` before deploying.
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "database/.generated/d1-migrations"
  }],
  "observability": { "enabled": true }
}
