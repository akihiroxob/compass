{
  "name": "@compass/ralph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bin/ralph run",
    "build": "npm run check:sh",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "npm run check:sh && tsc -p tsconfig.json",
    "check:sh": "for f in bin/ralph bin/ralph-loop backends/*.sh providers/*.sh; do bash -n \"$f\" || exit 1; done",
    "test": "node --import tsx --test \"tests/**/*.test.ts\""
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
