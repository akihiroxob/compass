{
  "name": "compass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "orchestrator",
    "packages/*"
  ],
  "scripts": {
    "prestart": "npm run build",
    "start": "tsx server/src/main.ts",
    "cli": "tsx server/src/cli/main.ts",
    "dev": "npm-run-all --parallel dev:server dev:frontend",
    "dev:server": "tsx watch server/src/main.ts",
    "dev:frontend": "vite --config server/src/web/vite.config.ts",
    "build": "npm run build --workspace server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
