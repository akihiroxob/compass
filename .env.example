PORT=51800
COMPASS_DB_PATH=compass.db
# Execution（Story / Task）のClaim有効期間（ミリ秒）。既定は1800000（30分）
# COMPASS_CLAIM_TTL_MS=1800000

# Human認証（docs/step-6-human-auth-design.md）。既定はremoteで、必須値が無ければ起動を拒否する
# remote: COMPASS_PUBLIC_ORIGIN（https）・Google client ID / secretが必須。trusted-local: loopback bind限定の開発用（NODE_ENV=productionでは起動拒否）
# Agent / Runtimeは、remoteではWeb UIでProjectのAdministratorが発行したCredential（Bearer cmp_agent... / cmp_runtime...）だけで認証する。
# trusted-localだけはAgent名のBearer（自己申告）も受け付ける。
# COMPASS_AUTH_MODE=trusted-local
# listenするhost。trusted-localの既定は127.0.0.1で、loopback以外は起動拒否。remoteの既定は全interface
# COMPASS_HOST=127.0.0.1
# 公開origin（CSRFのOrigin照合・OIDC redirect URIの基準）。trusted-localの既定は http://localhost:$PORT
# COMPASS_PUBLIC_ORIGIN=https://compass.example.com
# Google Cloudで作成したOAuth client。承認済みredirect URIは ${COMPASS_PUBLIC_ORIGIN}/auth/google/callback
# secretはシェル・secret管理機構から渡し、ファイルへ保存しない
# COMPASS_GOOGLE_CLIENT_ID=
# COMPASS_GOOGLE_CLIENT_SECRET=
# 初期owner。platform ownerが未作成の間は必須（作成後は読まない）
# COMPASS_INITIAL_OWNER_EMAIL=owner@example.com
# closedのみ対応
# COMPASS_REGISTRATION_MODE=closed
