# Compass Ralph の Operational Log
.compass-ralph/

# Ralph の実行時生成物（.ralph/config.json と ralph/ のソース・設定例は管理対象）
# 実行ログ・ローテート済みログ
/.ralph/logs/
# GitHub連携の実行状態・完了記録
/.ralph/github-state/
# ホスト検証の結果・ログ
/.ralph/verification/
# 旧形式の停止状態（移行時の参照用）
/.ralph/pauses/
# Principal・Role別の停止状態、進捗なし回数、Providerの利用制限
/.ralph/runtime.json
# 共有状態更新用のOSロック
/.ralph/runtime.lock
# Principal・Role別の起動ロック
/.ralph/runners/
# Agent実行用の一時worktree
/.ralph/worktrees/
# 旧形式のProvider利用制限（移行時の参照用）
/.ralph/quota.json
# 旧形式のRunnerプロセスID（移行時の稼働確認用）
/.ralph/runner.pid
# 実行Contextから生成するMCP設定
/.ralph/mcp.json
# Repo-localインストールのRunner本体
/.ralph/runtime/
# Agent実行結果
.ralph-result.json

# Storybook generated catalog
storybook-static/
