{
  "projectName": "compass",
  "taskBackend": "wacha",
  "agentProvider": "claude",
  "pollIntervalSeconds": 300,
  "retry": {
    "initialSeconds": 300,
    "tokenLimitSeconds": 1800
  },
  "github": {
    "enabled": true
  },
  "logging": {
    "path": ".ralph/logs/ralph.log",
    "idleHeartbeatSeconds": 3600
  },
  "wacha": {
    "url": "http://localhost:51743/mcp"
  },
  "claude": {
    "command": "claude",
    "dangerouslySkipPermissions": true
  },
  "codex": {
    "command": "codex",
    "dangerouslyBypassApprovalsAndSandbox": false
  },
  "roles": {
    "worker": {
      "agentName": "worker",
      "agentProvider": "claude",
      "model": ""
    },
    "reviewer": {
      "agentName": "reviewer",
      "agentProvider": "codex",
      "model": ""
    },
    "manager": {
      "agentName": "accepter",
      "agentProvider": "codex",
      "model": ""
    }
  },
  "verification": {
    "hostCommands": [
      [
        "node",
        "--import",
        "tsx",
        "--test",
        "--test-concurrency=1",
        "server/tests/humanAuthHttpIntegration.test.ts",
        "server/tests/lv6ClosedLoop.test.ts",
        "server/tests/researchDecisionIntegration.test.ts",
        "server/tests/strategistIntegration.test.ts",
        "orchestrator/tests/integration.test.ts",
        "ralph/tests/ralph.test.ts"
      ]
    ]
  }
}
