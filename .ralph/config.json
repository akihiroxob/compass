{
  "projectName": "compass",
  "taskBackend": "wacha",
  "agentProvider": "claude",
  "pollIntervalSeconds": 300,
  "retry": {
    "initialSeconds": 300,
    "tokenLimitSeconds": 1800
  },
  "github": {
    "enabled": true
  },
  "logging": {
    "path": ".ralph/logs/ralph.log",
    "idleHeartbeatSeconds": 3600
  },
  "wacha": {
    "url": "http://localhost:51743/mcp"
  },
  "claude": {
    "command": "claude",
    "dangerouslySkipPermissions": true
  },
  "codex": {
    "command": "codex",
    "dangerouslyBypassApprovalsAndSandbox": true
  },
  "roles": {
    "worker": {
      "agentName": "worker",
      "agentProvider": "claude",
      "model": ""
    },
    "reviewer": {
      "agentName": "reviewer",
      "agentProvider": "codex",
      "model": "gpt-6.1-sol"
    },
    "manager": {
      "agentName": "accepter",
      "agentProvider": "codex",
      "model": ""
    }
  },
  "verification": {
    "preparationFiles": [
      "scripts/prepare-browser-verification.mjs",
      "scripts/preview-operation-policy.mjs",
      "scripts/verify-consultation-resumption.mjs",
      "docs/browser-verification.md"
    ],
    "preparationRevision": "9cca1f332ce1051256eb47e69abc23a486f6de30",
    "hostCommands": [
      [
        "node",
        "--import",
        "tsx",
        "--test",
        "--test-concurrency=1",
        "server/tests/humanAuthHttpIntegration.test.ts",
        "server/tests/lv6ClosedLoop.test.ts",
        "server/tests/researchDecisionIntegration.test.ts",
        "server/tests/strategistIntegration.test.ts",
        "orchestrator/tests/integration.test.ts",
        "ralph/tests/ralph.test.ts"
      ],
      [
        "node",
        "--import",
        "tsx",
        "/Users/aokayama/git/compass/scripts/verify-consultation-resumption.mjs"
      ]
    ],
    "browser": {
      "command": ["npm", "start"],
      "env": {
        "PORT": "{port}",
        "COMPASS_DB_PATH": "{dataDir}/preview.db",
        "COMPASS_AUTH_MODE": "trusted-local",
        "COMPASS_HOST": "127.0.0.1",
        "COMPASS_PUBLIC_ORIGIN": "http://127.0.0.1:{port}",
        "COMPASS_INITIAL_OWNER_EMAIL": "preview-owner@example.test",
        "COMPASS_CLAIM_TTL_MS": "60000"
      },
      "readyPath": "/",
      "setupCommands": [
        ["npm", "ci", "--ignore-scripts"],
        ["npm", "rebuild", "better-sqlite3"],
        [
          "node",
          "--import",
          "tsx",
          "/Users/aokayama/git/compass/scripts/prepare-browser-verification.mjs",
          "--data-dir",
          "{dataDir}"
        ]
      ],
      "profiles": {
        "prototype": {
          "command": [
            "npm",
            "--prefix",
            "/Users/aokayama/git/compass-prototype",
            "run",
            "dev",
            "--",
            "--host",
            "127.0.0.1",
            "--port",
            "{port}",
            "--strictPort"
          ],
          "readyPath": "/",
          "setupCommands": []
        },
        "catalog": {
          "command": [
            "npm",
            "exec",
            "--workspace",
            "server",
            "--",
            "storybook",
            "dev",
            "--port",
            "{port}",
            "--host",
            "127.0.0.1",
            "--no-open",
            "--disable-telemetry"
          ],
          "readyPath": "/index.json",
          "setupCommands": [
            ["npm", "ci", "--ignore-scripts"],
            ["npm", "rebuild", "better-sqlite3"],
            ["npm", "run", "build"]
          ]
        },
        "catalog-static": {
          "command": [
            "/Library/Developer/CommandLineTools/usr/bin/python3",
            "-m",
            "http.server",
            "{port}",
            "--bind",
            "127.0.0.1",
            "--directory",
            "server/storybook-static"
          ],
          "readyPath": "/index.json",
          "setupCommands": [
            ["npm", "ci", "--ignore-scripts"],
            ["npm", "rebuild", "better-sqlite3"],
            ["npm", "run", "build"],
            ["npm", "run", "catalog:build"]
          ]
        }
